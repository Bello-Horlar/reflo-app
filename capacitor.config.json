{
  "appId": "com.reflo.app",
  "appName": "REFLO",
  "webDir": "www",
  "appendUserAgent": "RefloNativeApp",
  "server": {
    "cleartext": true,
    "errorPath": "offline.html",
    "allowNavigation": [
      "reflohdc.netlify.app",
      "*.netlify.app",
      "*.paystack.co",
      "*.paystack.com",
      "checkout.paystack.com",
      "*.supabase.co"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#000000"
    }
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": false,
    "webContentsDebuggingEnabled": true
  }
}
